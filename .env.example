# GEMINI_API_KEY: obrigatória para o chat e o estúdio de imagens.
# Fica SOMENTE no servidor. Nunca use o prefixo VITE_ (exporia a chave no bundle).
# O AI Studio injeta este valor em runtime a partir dos Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde o app está hospedado (injetada pelo AI Studio / Cloud Run).
APP_URL="MY_APP_URL"

# --- Opcionais (valores padrão entre parênteses) -----------------------------

# Porta HTTP (3000)
# PORT=3000

# Respostas de contingência quando o Gemini falhar (true).
# Com false, erros do provedor são devolvidos ao cliente (502/503/504).
# AI_FALLBACK_ENABLED=true

# Timeouts das chamadas ao Gemini em ms (chat 30000 · imagem 90000)
# AI_CHAT_TIMEOUT_MS=30000
# AI_IMAGE_TIMEOUT_MS=90000

# Rate limit por IP (API geral 120/min · chat 20/min · imagens 5 a cada 10 min)
# RATE_LIMIT_API_PER_MINUTE=120
# RATE_LIMIT_CHAT_PER_MINUTE=20
# RATE_LIMIT_IMAGE_PER_10_MINUTES=5

# Proxies confiáveis para obter o IP real (1 em produção · false em dev).
# Em Cloud Run / atrás de 1 balanceador, mantenha 1.
# TRUST_PROXY=1

# Origens que podem embutir o site em <iframe> (separadas por vírgula).
# Necessário, por exemplo, para o preview do AI Studio. Padrão: só a própria origem.
# FRAME_ANCESTORS=https://aistudio.google.com

# --- Pedidos pelo WhatsApp (Twilio) — SOMENTE no servidor ---------------------
# Sem estas variáveis, POST /api/orders responde 503 e o site oferece o envio
# direto pelo app do WhatsApp (link wa.me).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# Remetente WhatsApp habilitado na Twilio (sandbox: +14155238886)
# TWILIO_WHATSAPP_FROM=+14155238886
# WhatsApp da loja que recebe os pedidos (E.164)
# STORE_WHATSAPP_TO=+5548999999999
# Enviar também confirmação ao cliente (exige opt-in/template aprovado) (false)
# TWILIO_NOTIFY_CUSTOMER=false
# Timeout da chamada à Twilio em ms (10000)
# TWILIO_TIMEOUT_MS=10000
# Pedidos por IP a cada 10 minutos (5)
# RATE_LIMIT_ORDERS_PER_10_MINUTES=5

# Origens externas que podem chamar esta API (ex.: o site no GitHub Pages)
# CORS_ORIGINS=https://carlosserra-a11y.github.io

# --- Frontend (VITE_*) — vão para o bundle público, NUNCA coloque segredos ----
# URL do backend quando o site é hospedado separado (ex.: GitHub Pages)
# VITE_API_BASE_URL=https://sua-api.exemplo.com
# WhatsApp da loja para o link wa.me (só dígitos, com DDI)
# VITE_STORE_WHATSAPP_NUMBER=5548999999999
